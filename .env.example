# Replit Secrets Configuration Guide
# This file is for reference only - environment variables are managed through Replit Secrets

# Current Stripe Environment Variables (already configured)
STRIPE_SECRET_KEY=sk_test_or_sk_live_your_secret_key_here
VITE_STRIPE_PUBLIC_KEY=pk_test_or_pk_live_your_public_key_here
STRIPE_PRO_PRODUCT_ID=price_your_pro_product_id_here
STRIPE_ULTIMATE_PRODUCT_ID=price_your_ultimate_product_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Other Environment Variables
DATABASE_URL=postgresql://...
PGDATABASE=...
PGHOST=...
PGPASSWORD=...
PGPORT=...
PGUSER=...
SESSION_SECRET=your_session_secret_here
REPLIT_DOMAINS=your_replit_domains_here
REPL_ID=your_repl_id_here
ISSUER_URL=https://replit.com/oidc

# Environment Detection:
# - The system automatically detects test/live environment from key prefixes
# - sk_test_ = test environment, sk_live_ = live environment
# - pk_test_ = test environment, pk_live_ = live environment
# - No additional configuration needed for environment switching

# To switch environments:
# 1. Update STRIPE_SECRET_KEY from sk_test_ to sk_live_ (or vice versa)
# 2. Update VITE_STRIPE_PUBLIC_KEY from pk_test_ to pk_live_ (or vice versa)
# 3. Update product IDs and webhook secrets accordingly
# 4. The system will automatically detect the environment change

# Database
DATABASE_URL=postgresql://...
PGDATABASE=...
PGHOST=...
PGPASSWORD=...
PGPORT=...
PGUSER=...

# Session
SESSION_SECRET=your_session_secret_here

# Replit
REPLIT_DOMAINS=your_replit_domains_here
REPL_ID=your_repl_id_here
ISSUER_URL=https://replit.com/oidc