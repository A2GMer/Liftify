# Replit Secrets Configuration Guide
# This file is for reference only - environment variables are managed through Replit Secrets

# Stripe Environment Configuration
# Set to "test" for development, "live" for production
STRIPE_ENVIRONMENT=test

# Stripe Test Keys (for development)
STRIPE_TEST_SECRET_KEY=sk_test_your_test_secret_key_here
VITE_STRIPE_TEST_PUBLIC_KEY=pk_test_your_test_public_key_here
STRIPE_TEST_PRO_PRODUCT_ID=price_test_your_pro_product_id_here
STRIPE_TEST_ULTIMATE_PRODUCT_ID=price_test_your_ultimate_product_id_here
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Frontend Environment Setting (must match STRIPE_ENVIRONMENT)
VITE_STRIPE_ENVIRONMENT=test

# Stripe Live Keys (for production)
STRIPE_LIVE_SECRET_KEY=sk_live_your_live_secret_key_here
VITE_STRIPE_LIVE_PUBLIC_KEY=pk_live_your_live_public_key_here
STRIPE_LIVE_PRO_PRODUCT_ID=price_live_your_pro_product_id_here
STRIPE_LIVE_ULTIMATE_PRODUCT_ID=price_live_your_ultimate_product_id_here
STRIPE_LIVE_WEBHOOK_SECRET=whsec_live_your_webhook_secret_here

# Legacy Stripe Keys (for backward compatibility)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_PRO_PRODUCT_ID=price_your_pro_product_id_here
STRIPE_ULTIMATE_PRODUCT_ID=price_your_ultimate_product_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Instructions for Replit Secrets:
# 1. Go to Replit Secrets tab in your project
# 2. Add the environment variables listed above
# 3. Set STRIPE_ENVIRONMENT to "test" or "live" to switch environments
# 4. Set VITE_STRIPE_ENVIRONMENT to match STRIPE_ENVIRONMENT for frontend

# Database
DATABASE_URL=postgresql://...
PGDATABASE=...
PGHOST=...
PGPASSWORD=...
PGPORT=...
PGUSER=...

# Session
SESSION_SECRET=your_session_secret_here

# Replit
REPLIT_DOMAINS=your_replit_domains_here
REPL_ID=your_repl_id_here
ISSUER_URL=https://replit.com/oidc